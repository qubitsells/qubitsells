# Public authentication configuration (intentionally browser-visible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Production: set NEXT_PUBLIC_BASE_URL=https://qubitsells.com after domain setup.
# support@qubitsells.com is the planned support address; activate before launch.
# Stripe is planned but not integrated. Do not accept paid sales until real
# checkout, verified webhooks, duration pricing, and fulfillment are implemented.

# Server-only: never give these a NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Generate strong local values with: npm run security:setup
# Preserve/back up the encryption key; all deployed instances need the same key.
CAPSULE_ENCRYPTION_KEY=replace-with-64-hex-characters
IP_HASH_SALT=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret

# Non-Vercel hosting only: reverse proxy must strip/overwrite this header.
# TRUSTED_PROXY_IP_HEADER=x-real-ip
