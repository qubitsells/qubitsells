# Public authentication configuration (intentionally browser-visible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Alternatively set NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead of ANON_KEY.
# Google OAuth Client ID/Secret go in Supabase Auth > Providers > Google,
# not in NEXT_PUBLIC_ variables. See docs/google-sign-in.md for activation.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Production: set NEXT_PUBLIC_BASE_URL=https://qubitsells.com after domain setup.
# support@qubitsells.com is the planned support address; activate before launch.
# Stripe test checkout (server-only; never use NEXT_PUBLIC_ for either secret)
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_replace-with-your-test-secret
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-webhook-secret
# Forward checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# and charge.refunded to /api/stripe/webhook. Apply the commerce migration first.

# Server-only: never give these a NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Generate strong local values with: npm run security:setup
# Preserve/back up the encryption key; all deployed instances need the same key.
CAPSULE_ENCRYPTION_KEY=replace-with-64-hex-characters
IP_HASH_SALT=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret

# Non-Vercel hosting only: reverse proxy must strip/overwrite this header.
# TRUSTED_PROXY_IP_HEADER=x-real-ip
