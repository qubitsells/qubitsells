    "security:check-bundle": "node scripts/check-client-secrets.mjs",
    "security:setup": "node scripts/setup-security.mjs",
    "security:migrate-media": "tsx --conditions=react-server scripts/migrate-private-media.mts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@types/canvas-confetti": "^1.9.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.35.0",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fast-glob": "file:vendor/safe-glob",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch@<9": { "brace-expansion": "1.1.21" },
    "minimatch@>=9": { "brace-expansion": "5.0.12" },
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
