{
  "name": "cpltools-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
